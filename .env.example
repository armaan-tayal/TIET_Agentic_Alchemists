# Copy to .env. Never commit the real .env.
# Meta Model API key (Muse Spark) from the dev.meta.ai dashboard. Looks like: LLM|<app-id>|<secret>
MODEL_API_KEY=
# LLM used for enrich/extract/repair (only on cache misses)
LLM_MODEL=muse-spark-1.3
# Anthropic-Messages-compatible endpoint host (the SDK appends /v1/messages)
LLM_BASE_URL=https://api.meta.ai
# auto = LLM when a key is present, else deterministic rules; rules = never call the LLM
PIPELINE_MODE=auto
# Optional overrides (defaults come from thresholds.json, written by `python eval/run_eval.py --tune`)
# HIT_THRESHOLD=0.9
# BORDERLINE_LOW=0.7
# CE_HIT_THRESHOLD=0.4
# DL_THRESHOLD=0.856
# CACHE_DB=cache.sqlite3
